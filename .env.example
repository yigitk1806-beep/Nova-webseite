# ─── Datenbank ─────────────────────────────────────────────
# Anwendungsrolle (kein Tabelleneigentümer → RLS wird erzwungen)
DATABASE_URL=postgresql://onyx_app:onyx_app_dev@localhost:5432/onyx
# Eigentümer-/Migrationsrolle (nur für prisma migrate)
MIGRATION_DATABASE_URL=postgresql://onyx_owner:onyx_owner_dev@localhost:5432/onyx

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────
# Mindestens 32 Zeichen, z. B. `openssl rand -base64 48`
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000

# ─── E-Mail ───────────────────────────────────────────────
# In Produktion Pflicht. In Entwicklung ohne Wert: Links werden ins Server-Log geschrieben.
SMTP_URL=
MAIL_FROM="ONYX <no-reply@example.com>"

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
