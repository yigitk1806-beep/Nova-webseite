// ONYX – Datenbankschema Phase 1 (Tenancy, Identity, Permissions, Audit)
// Siehe DATABASE_SCHEMA.md. RLS-Policies liegen in der SQL-Migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Tenancy ─────────────

model Tenant {
  id                      String   @id @default(cuid(2))
  slug                    String   @unique
  name                    String
  plan                    Plan     @default(FREE)
  dataRegion              String   @default("eu-central")
  settings                Json     @default("{}")
  retentionDays           Int      @default(365)
  /// Kill Switch: false → keine neuen Agent-Läufe, laufende werden abgebrochen
  agentsEnabled           Boolean  @default(true)
  /// Monatliches LLM-Budget in Cent (null = unbegrenzt)
  agentMonthlyBudgetCents Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships Membership[]
  agents      AgentDefinition[]
  agentRuns   AgentRun[]
  usage       UsageRecord[]
  roles       Role[]
  invitations Invitation[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String           @id @default(cuid(2))
  tenantId  String
  userId    String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, roleId])
}

model Invitation {
  id          String    @id @default(cuid(2))
  tenantId    String
  email       String
  roleId      String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
}

// ───────────── Permissions ─────────────

/// tenantId = null → Systemrolle (owner/admin/member/viewer), für alle Tenants sichtbar.
model Role {
  id          String   @id @default(cuid(2))
  tenantId    String?
  key         String
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, key])
}

model ApiKey {
  id          String    @id @default(cuid(2))
  tenantId    String
  name        String
  prefix      String
  hash        String    @unique
  permissions String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ───────────── Audit (append-only) ─────────────

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  tenantId   String
  actorType  ActorType
  actorId    String
  action     String
  resource   String
  resourceId String?
  outcome    Outcome
  metadata   Json      @default("{}")
  requestId  String?
  ipHash     String?
  prevHash   String?
  hash       String
  createdAt  DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
}

// ───────────── Agents (Phase 2) ─────────────

model AgentDefinition {
  id              String   @id @default(cuid(2))
  tenantId        String
  key             String
  name            String
  description     String?
  activeVersionId String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions AgentVersion[]

  @@unique([tenantId, key])
}

/// Unveränderlich: Änderungen erzeugen eine neue Version.
model AgentVersion {
  id           String   @id @default(cuid(2))
  tenantId     String
  agentId      String
  version      Int
  systemPrompt String
  model        String
  effort       String   @default("medium")
  tools        String[]
  permissions  String[]
  maxSteps     Int      @default(12)
  maxTokens    Int      @default(16000)
  /// Kostenlimit pro Lauf in Cent
  budgetCents  Int      @default(100)
  createdById  String
  createdAt    DateTime @default(now())

  agent AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  AgentRun[]

  @@unique([agentId, version])
  @@index([tenantId])
}

model AgentRun {
  id              String    @id @default(cuid(2))
  tenantId        String
  agentVersionId  String
  triggeredByType ActorType
  triggeredById   String
  status          RunStatus @default(QUEUED)
  input           Json
  output          Json?
  error           String?
  /// Tatsächlich antwortendes Modell (kann bei Fallback abweichen)
  servedModel     String?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  costMicroCents  BigInt    @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  steps   AgentStep[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model AgentStep {
  id             String     @id @default(cuid(2))
  tenantId       String
  runId          String
  index          Int
  type           StepType
  toolKey        String?
  input          Json?
  output         Json?
  riskClass      RiskClass?
  status         StepStatus
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  costMicroCents BigInt?
  durationMs     Int?
  createdAt      DateTime   @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([tenantId])
}

model UsageRecord {
  id             String   @id @default(cuid(2))
  tenantId       String
  kind           String
  model          String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicroCents BigInt
  refId          String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ───────────── Identity (Better Auth) ─────────────
// Feldnamen entsprechen dem Better-Auth-Kernschema.

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  /// Better Auth two-factor plugin
  twoFactorEnabled Boolean? @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  twoFactors  TwoFactor[]
}

/// Better Auth two-factor plugin. Das TOTP-Secret wird von Better Auth verschlüsselt gespeichert.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ───────────── Enums ─────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  API_KEY
}

enum RiskClass {
  READ
  WRITE
  EXTERNAL_COMMUNICATION
  FINANCIAL
  DESTRUCTIVE
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepType {
  LLM_CALL
  TOOL_CALL
  POLICY_DENIED
}

enum StepStatus {
  SUCCEEDED
  FAILED
  DENIED
}

enum Outcome {
  SUCCESS
  DENIED
  FAILED
}
