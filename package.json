{
  "name": "onyx",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @onyx/web dev",
    "dev:worker": "pnpm --filter @onyx/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @onyx/db generate",
    "db:migrate": "pnpm --filter @onyx/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @onyx/db migrate:dev",
    "db:seed": "pnpm --filter @onyx/db seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
